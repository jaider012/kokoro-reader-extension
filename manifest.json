{
  "manifest_version": 3,
  "name": "Kokoro Reader",
  "version": "0.1.0",
  "description": "Reads web pages and selections aloud with a local Kokoro TTS server.",
  "permissions": ["offscreen", "contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8880/*", "http://localhost:8880/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kokoro Reader",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "read-or-stop": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Read the active tab aloud, or stop if already reading"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Pause or resume reading"
    }
  }
}
